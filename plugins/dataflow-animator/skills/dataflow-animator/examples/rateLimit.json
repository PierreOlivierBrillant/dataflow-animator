  "timeline": [
    {
      "type": "comment",
      "text": "A reverse proxy caps how many requests each IP may send. Past the limit, it answers 429 itself — the backend never sees the flood."
    },
    {
      "type": "comment",
      "object": "attacker",
      "text": "The attacker floods from a single IP: every request lands on the proxy."
    },
