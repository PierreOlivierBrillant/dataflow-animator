{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "scripts/*.mjs",
        "rollup.dts.config.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["react-icons"]
    },
    "packages/element": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "scripts/*.mjs",
        "rollup.dts.config.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/*.mjs"]
    },
    "packages/react": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "scripts/*.mjs",
        "rollup.dts.config.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "scripts/*.mjs",
        "scripts/validation-harness/**/*.{ts,tsx}"
      ]
    },
    "apps/docs": {
      "entry": [
        "src/pages/**/*.tsx",
        "src/site-content/index.ts",
        "src/theme/**/*.tsx",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      // @dataflow-animator/core is reached ONLY from src/css/custom.css
      // (`@import '@dataflow-animator/core/styles.css'`), and `project` covers
      // .ts/.tsx only — knip cannot see it. The site needs it as a direct
      // dependency now that the React binding no longer emits the stylesheet.
      "ignoreDependencies": ["@dataflow-animator/core"]
    }
  },
  "ignore": ["eslint.config.js"],
  "ignoreDependencies": [
    "@docusaurus/theme-common",
    "@eslint/js",
    "autoprefixer",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "globals",
    "postcss",
    "tailwindcss",
    "typescript-eslint"
  ]
}
