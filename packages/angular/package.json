{
  "name": "@dataflow-animator/angular",
  "version": "1.0.0",
  "description": "Angular binding for @dataflow-animator/core: a standalone component that compiles a JSON specification into a deterministic, scrubbable animation of data flows.",
  "license": "MIT",
  "keywords": [
    "angular",
    "animation",
    "diagram",
    "dataflow",
    "teaching",
    "visualization",
    "standalone-component"
  ],
  "author": "Pierre-Olivier Brillant",
  "homepage": "https://pierreolivierbrillant.github.io/dataflow-animator/",
  "bugs": "https://github.com/PierreOlivierBrillant/dataflow-animator/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PierreOlivierBrillant/dataflow-animator.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "dev": "ng-packagr -p ng-package.json -c tsconfig.lib.json --watch",
    "lint": "eslint src",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "smoke:consumer": "node scripts/smoke-consumer.mjs"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0"
  },
  "dependencies": {
    "@dataflow-animator/core": "^1.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.3.0",
    "jsdom": "^26.1.0",
    "ng-packagr": "^22.1.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "zone.js": "^0.16.2"
  }
}
