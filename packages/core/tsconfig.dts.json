{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": [],
    "resolveJsonModule": true
  },
  // Tests excluded: they are not part of the published surface, and a `.d.ts`
  // built from them would drag vitest's types into the program.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
