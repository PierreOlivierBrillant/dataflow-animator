{
  "name": "@dataflow-animator/core",
  "version": "0.1.0",
  "description": "Framework-agnostic engine and DOM renderer for deterministic, scrubbable data-flow animations compiled from a JSON spec.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "animation",
    "diagram",
    "dataflow",
    "teaching",
    "visualization",
    "vanilla",
    "framework-agnostic"
  ],
  "author": "Pierre-Olivier Brillant",
  "homepage": "https://github.com/PierreOlivierBrillant/react-dataflow-animator",
  "repository": {
    "type": "git",
    "url": "https://github.com/PierreOlivierBrillant/react-dataflow-animator.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/generate-schema.mjs && npm run typecheck && vite build && rollup -c rollup.dts.config.mjs",
    "postbuild": "cp src/schema.generated.json dist/schema.json",
    "generate:schema": "node scripts/generate-schema.mjs",
    "check:schema": "node scripts/check-schema-is-fresh.mjs",
    "generate:subicons": "node scripts/generate-subicon-data.mjs",
    "check:subicons": "node scripts/check-subicon-data-is-fresh.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "jsdom": "^26.1.0",
    "react-icons": "^5.6.0",
    "rollup": "^4.61.1",
    "rollup-plugin-dts": "^6.4.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
