{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    // In-repo, everything resolves the core to its SOURCE: this program, vitest
    // and the harness all agree, so there is no build-order coupling (no need to
    // have built `../core/dist` before typechecking) and a core edit is visible
    // immediately. The PUBLISHED contract — does the core's flattened
    // `dist/index.d.ts` really expose what `src/` imports? — is verified where it
    // belongs, on the real tarballs, by the external consumer smoke test.
    //
    // The `/*` entry is what the harness needs: it reaches deep subpaths that the
    // core's published `exports` no longer lists.
    "paths": {
      "@dataflow-animator/core": ["../core/src/index.ts"],
      "@dataflow-animator/core/*": ["../core/src/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  // `../core/src/**/*.d.ts`: ambient module declarations (e.g. the Prism
  // components typing) live in the core workspace now. `include` only
  // resolves the ROOT file set for the program — files pulled in transitively
  // via `paths` are added too, but a loose ambient `.d.ts` with no import is
  // never reached that way, so it must be listed explicitly (same reasoning
  // as vite.config.ts's `watch.include`, which isn't additive either).
  "include": ["src", "../core/src/**/*.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
