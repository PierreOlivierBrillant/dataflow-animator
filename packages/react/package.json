{
  "name": "@dataflow-animator/react",
  "version": "2.0.0",
  "description": "React binding for @dataflow-animator/core: compiles a JSON specification into a deterministic, scrubbable animation of data flows.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "animation",
    "diagram",
    "dataflow",
    "docusaurus",
    "teaching",
    "visualization"
  ],
  "author": "Pierre-Olivier Brillant",
  "homepage": "https://pierreolivierbrillant.github.io/dataflow-animator/",
  "bugs": "https://github.com/PierreOlivierBrillant/dataflow-animator/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PierreOlivierBrillant/dataflow-animator.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && node ../core/scripts/generate-schema.mjs && tsc -b tsconfig.app.json tsconfig.node.json && vite build && rollup -c rollup.dts.config.mjs",
    "dev": "vite build --watch",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@dataflow-animator/core": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rollup": "^4.61.1",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
